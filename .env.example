# Copy this file to .env and replace every placeholder with your own values.
PORT=5000
APP_BASE_URL=http://localhost:5000

# Admin account created on first server start when these are configured.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set to true for one startup to reset an existing admin password, then remove it.
ADMIN_RESET_PASSWORD=false

# Google Gemini API key used by the server only.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# SMTP settings used by the forgot-password email flow.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=Lunara AI <no-reply@example.com>
